DATABASE_URL=postgresql://USUARIO:SENHA@172.17.0.1:5432/bomflow
PUBLIC_APP_URL=https://bomflow.seu-dominio.com.br
JWT_SECRET=sua-chave-jwt-aqui
SESSION_SECRET=sua-chave-session-aqui
RUDO_WHATSAPP_TOKEN=token-whu-do-canal-principal
BOM_AUTO_CONTRACT_WHATSAPP_TOKEN=token-whu-do-canal-de-contratos

# Pasta PERSISTENTE (no host) onde os documentos de orcamento sao gravados.
# Deve corresponder ao bind mount definido em docker-compose.yml.
# NAO exponha esta pasta via Nginx/Apache como conteudo estatico: o acesso e
# somente pela aplicacao autenticada.
ORCAMENTO_DOCS_DIR=/var/dados/bomflow/orcamento-documentos

# O Portal de Treinamentos usa um volume privado gerenciado pelo Docker.
# SESSION_SECRET assina URLs temporarias de leitura; mantenha uma chave forte.
TRAINING_STORAGE_DRIVER=local
TRAINING_STORAGE_DIR=/var/dados/bomflow/treinamentos
